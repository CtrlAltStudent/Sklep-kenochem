DATABASE_URL=postgres://sonax:sonax_dev@127.0.0.1:5434/sonax_shop
PAYLOAD_SECRET=wygeneruj-losowy-ciag-min-32-znaki
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Klucze integracji najlepiej wpisywać w panelu: /admin/integracje (zaszyfrowane w integrations.json obok bazy).
# Poniższe zmienne działają zapasowo, gdy w panelu pole jest puste.
# Harmonogram synchronizacji w tle: na serwerze włączony sam, lokalnie INTEGRATIONS_SCHEDULER=1.

# BaseLinker (token z panelu: Moje konto → API). MOCK=1 = nic nie idzie na prawdziwe konto.
BASELINKER_TOKEN=
BASELINKER_MOCK=1
# Hasło z BaseLinker → Integracje → Inny sklep (żeby zamówienia wchodziły jako sklep, nie „Admin”).
BASELINKER_SHOP_PASS=

# Przelewy24 (klucze z panelu P24). MOCK=1 = zamówienie od razu opłacone, bez okna płatności.
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=1
P24_MOCK=1

# InPost Geowidget (mapa paczkomatów) – opcjonalnie; bez tego klient wpisuje kod, np. BIA01M
INPOST_GEOWIDGET_TOKEN=
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=

# ORLEN Paczka – mapa punktów (opcjonalnie); bez tego klient wpisuje kod punktu
ORLEN_MAP_KEY=
NEXT_PUBLIC_ORLEN_MAP_KEY=

NEXT_PUBLIC_SKIP_KENOCHEM_IMAGES=0
