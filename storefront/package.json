{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed": "cross-env PAYLOAD_DB_PUSH=0 NODE_OPTIONS=--no-deprecation payload run src/seed.ts",
    "import:csv": "node scripts/import-products.mjs",
    "check:images": "node scripts/check-images.mjs",
    "verify:baselinker": "cross-env PAYLOAD_DB_PUSH=0 NODE_OPTIONS=--no-deprecation payload run src/scripts/verify-baselinker.ts",
    "verify:checkout": "cross-env PAYLOAD_DB_PUSH=0 P24_MOCK=1 NODE_OPTIONS=--no-deprecation payload run src/scripts/verify-checkout.ts",
    "seed:pages": "cross-env PAYLOAD_DB_PUSH=0 NODE_OPTIONS=--no-deprecation payload run src/seed-pages.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "cross-env": "^10.1.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "nodemailer": "^7.0.13",
    "payload": "3.91.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
